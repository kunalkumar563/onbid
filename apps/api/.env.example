# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed frontend origins, or "*" for dev.
CORS_ORIGINS=*

# --- Postgres (Prisma) ---
DATABASE_URL="postgresql://onbid:onbid@localhost:5432/onbid?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- JWT (RS256) ---
# Generate a real keypair with: npx ts-node scripts/generate-jwt-keys.ts
# Paste the two output lines below as-is (they already have \n escaped for you).
JWT_ACCESS_PRIVATE_KEY=""
JWT_ACCESS_PUBLIC_KEY=""
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- KYC provider ---
# 'signzy' or 'idfy'. See src/modules/kyc/providers — only Signzy is implemented
# so far, and against PLACEHOLDER endpoint paths (see signzy.provider.ts header
# comment). Fill these in once you have real sandbox credentials.
KYC_PROVIDER=signzy

SIGNZY_BASE_URL=https://preproduction.signzy.tech
SIGNZY_USERNAME=
SIGNZY_API_KEY=
# Publicly reachable URL where Signzy should POST verification callbacks,
# e.g. https://your-app.up.railway.app/api/kyc/webhook
SIGNZY_CALLBACK_URL=
# Shared secret used to HMAC-verify inbound webhooks. Generate any long random
# string for now; replace with whatever Signzy's actual signing scheme requires.
SIGNZY_WEBHOOK_SECRET=

IDFY_BASE_URL=https://eve.idfy.com
IDFY_ACCOUNT_ID=
IDFY_API_KEY=
IDFY_WEBHOOK_URL=
IDFY_WEBHOOK_SECRET=

# --- Razorpay (verification fee + entry fee + winning-bid payment) ---
# Built against Razorpay's current public API docs (confirmed via search,
# not just training-data memory) — unlike Signzy, this integration is
# complete and accurate, just needs real key values to actually run.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Route (linked accounts + held transfers for seller payouts) needs Route
# specifically enabled on your Razorpay/RazorpayX account — it's a separate
# product from vanilla Payments. See README §2 for what's confirmed vs. not
# about the Linked Account field schema specifically.

# --- Cloudflare R2 (listing/verification/delivery photos) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=onbid-media
# https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public/CDN base URL for reading objects back, e.g. a custom domain or
# R2.dev subdomain. If unset, falls back to constructing an R2 endpoint URL
# directly (only works if the bucket is public).
R2_PUBLIC_BASE_URL=

# --- Notifications (Phase 7) ---
# Firebase service-account JSON, as a single-line string. Get this from
# Firebase Console > Project Settings > Service Accounts > Generate new
# private key, then flatten it to one line before pasting here.
FCM_SERVICE_ACCOUNT_JSON=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@onbid.example
SENDGRID_FROM_NAME=Onbid

# How long before an auction ends / a payment deadline expires to send a
# reminder. Not specified anywhere in the PRD/tech-stack docs — reasonable
# defaults, easy to tune without touching code.
AUCTION_ENDING_SOON_MINUTES=15
PAYMENT_REMINDER_HOURS_BEFORE=12
